LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
MAX_RESULTS=24
TOP_K=4
FRESHNESS_THRESHOLD_DAYS=180
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_ATTEMPTS=4
